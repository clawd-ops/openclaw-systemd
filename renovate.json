{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the upstream OpenClaw image this wraps",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": ["ARG OPENCLAW_VERSION=(?<currentValue>[0-9]{4}\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "ghcr.io/openclaw/openclaw",
      "datasourceTemplate": "docker"
    }
  ]
}
