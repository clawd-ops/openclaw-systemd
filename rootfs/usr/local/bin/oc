#!/bin/sh
# Run the OpenClaw CLI the way a local install would: as uid 1000, with the
# account's own HOME, the user manager's bus, OPENCLAW_HOME unset, and the
# image's CLI (not a copy on the state volume). Use it for every `openclaw`
# command from `kubectl exec`, which lands as root. It runs inside a scope
# carrying the install memory limit, so `oc gateway install` produces the
# same pinned heap as first boot.
#
# The Kubernetes env (config values and Secrets the OpenClaw config refers
# to) is loaded from the boot-time env file, so `oc` behaves the same from
# `kubectl exec` (which inherits the container env) and from a systemd job
# or other context that starts with an empty environment. Without it,
# OpenClaw cannot resolve its config and fails, e.g. "The systemd user
# session bus is unavailable". The file is written with double-quoted,
# POSIX-sh-compatible escaping, so sourcing it is exact. Callers that cannot
# read it (non-root) keep their own environment.
MEMMAX=$(cat /etc/openclaw-install-memmax)
if [ -r /run/openclaw/gateway.env ]; then
  set -a
  . /run/openclaw/gateway.env
  set +a
fi
# The env file is trusted operator input, but it must not steer this
# helper's own root-side plumbing (systemd-run, runuser, env). Re-pin the
# shell and loader environment; the CLI gets its PATH set explicitly below.
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT BASH_ENV ENV CDPATH
IFS=' 	
'
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
exec /usr/bin/systemd-run --quiet --scope -p MemoryMax="$MEMMAX" -- \
  runuser -u node --preserve-environment -- env -u OPENCLAW_HOME \
  HOME=/home/openclaw XDG_RUNTIME_DIR=/run/user/1000 \
  DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
  PATH=/usr/local/bin:/usr/bin:/bin openclaw "$@"
