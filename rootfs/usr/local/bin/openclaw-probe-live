#!/bin/sh
# Liveness: fail only for states that a container restart fixes.
# - PID 1 unreachable or shutting down.
# - The uid 1000 user manager not running: the gateway can't be managed and
#   will never read as "failed".
# - The gateway unit "failed": it crashed past systemd's restart limit.
# An intentionally stopped gateway ("inactive") PASSES, so `openclaw gateway
# stop` opens a maintenance window instead of a restart. So does a "failed"
# gateway whose last invocation was asked to stop (mark-stop-requested): the
# gateway can exit non-zero while shutting down, which systemd records as
# failed exactly like a crash. "degraded" passes too: an unrelated failed unit
# must not cause a restart loop. A gateway held
# stopped by a failed fail-closed repair (repair-blocked, see
# repair-if-needed) also passes: a container restart cannot fix that, and the
# operator needs the container up to repair it.
s=$(timeout 5 systemctl is-system-running 2>/dev/null)
case "$s" in running|degraded|starting|initializing) ;; *) echo "system=$s"; exit 1 ;; esac
[ "$(systemctl is-active user@1000.service)" = "active" ] || { echo "user@1000 not active"; exit 1; }
# setpriv, not runuser: runuser opens a PAM session, which logs two
# "session opened/closed" lines on every probe run (every 10s per probe).
gw() {
  setpriv --reuid=1000 --regid=1000 --init-groups -- env \
    XDG_RUNTIME_DIR=/run/user/1000 \
    DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
    systemctl --user "$@" openclaw-gateway.service 2>/dev/null
}
state=${OPENCLAW_SYSTEMD_STATE:-/home/openclaw/.openclaw/state/openclaw-systemd}
g=$(gw is-failed)
if [ "$g" = "failed" ]; then
  # Honor the block only for the image's current version, the same check
  # repair-if-needed applies, so a stale or hand-left file cannot hide an
  # unrelated crash past the restart limit.
  b=$state/repair-blocked
  if [ -f "$b" ]; then
    v=$(/usr/local/bin/node -p 'require("/app/package.json").version' 2>/dev/null)
    if [ -n "$v" ] && [ "$(sed -n '1s/ .*//p' "$b")" = "$v" ]; then
      echo "gateway held stopped by a failed repair: $(head -c 300 "$b")"; exit 0
    fi
  fi
  # A stop request recorded for this very invocation (a marker left by an
  # earlier run never matches a later crash). `gateway start` begins a new
  # invocation, which ends the window.
  id=$(gw show -p InvocationID --value)
  if [ -n "$id" ] && [ "$(head -n1 "$state/stop-requested" 2>/dev/null)" = "$id" ]; then
    echo "gateway stopped on request (exited failed)"; exit 0
  fi
  echo "gateway=failed"; exit 1
fi
# No answer at all means the user manager cannot be queried, which native
# commands would also hit; do not report healthy.
[ -n "$g" ] || { echo "gateway state unknown (user manager not answering)"; exit 1; }
exit 0
