#!/bin/sh
# ExecStartPre from /etc/systemd/user/service.d/10-openclaw-gateway-repair.conf,
# which applies to every user service; $1 is the unit name (%n) and anything
# other than the gateway returns immediately. For the gateway it runs as the
# state-owning account under its user manager, so the gateway unit's own
# environment (HOME, the boot env file) is already in place.
#
# Runs `openclaw doctor --fix --non-interactive`, the same repair the upstream
# image's entrypoint runs, but only when one of these holds:
#
#   upgrade       the image's OpenClaw version differs from the version last
#                 repaired successfully (or nothing has been repaired yet)
#   forced        $state/force-repair exists
#   failed start  the previous start never answered /healthz, so mark-healthy
#                 never cleared $state/start-pending
#
# Failure policy:
#   upgrade/forced  fail closed: exit non-zero so the gateway does not start on
#                   unmigrated state. The container stays up for inspection.
#   failed start    fail open: log it and start anyway. After MAX_ATTEMPTS
#                   repairs that did not lead to a healthy start, stop
#                   repairing until the gateway is healthy again, so a broken
#                   repair cannot loop forever.
#
# Doctor runs with OPENCLAW_SERVICE_REPAIR_POLICY=external: systemd owns the
# gateway lifecycle here, so Doctor must not stop, start or reinstall it.
set -u

[ "${1:-}" = openclaw-gateway.service ] || exit 0

MAX_ATTEMPTS=2
state=${HOME:?HOME not set}/.openclaw/state/openclaw-systemd
stamp=$state/repaired-version
pending=$state/start-pending
force=$state/force-repair

log() { echo "repair: $*"; }

mkdir -p "$state" || { log "cannot create $state"; exit 1; }

current=$(/usr/local/bin/node -p 'require("/app/package.json").version' 2>/dev/null)
if [ -z "$current" ]; then
  log "cannot read the OpenClaw version from /app/package.json"
  exit 1
fi
last=$(cat "$stamp" 2>/dev/null || true)

attempts=0
if [ -e "$pending" ]; then
  attempts=$(cat "$pending" 2>/dev/null || true)
  case "$attempts" in ''|*[!0-9]*) attempts=0 ;; esac
fi

reason=
mode=
if [ -e "$force" ]; then
  reason="forced by $force"
  mode=closed
elif [ "$last" != "$current" ]; then
  reason="upgrade ${last:-<never repaired>} -> $current"
  mode=closed
elif [ -e "$pending" ]; then
  if [ "$attempts" -ge "$MAX_ATTEMPTS" ]; then
    log "previous start never became healthy, but $attempts repair(s) already ran without fixing it; starting without repair"
  else
    reason="previous start never became healthy (repair $((attempts + 1)) of $MAX_ATTEMPTS)"
    mode=open
  fi
fi

if [ -z "$reason" ]; then
  # Fast path: nothing to do. Arm failed-start detection and get out of the way.
  [ -e "$pending" ] || echo 0 > "$pending"
  exit 0
fi

if [ "$mode" = open ]; then
  # Count the attempt before running it, so a repair that hangs or is killed
  # still counts toward the cap.
  echo $((attempts + 1)) > "$pending"
fi

log "running doctor --fix ($reason)"
start=$(date +%s)
case "${OPENCLAW_SYSTEMD_REPAIR_SIMULATE:-}" in
  # Test hook only: exercises the decision logic without running Doctor.
  ok) rc=0 ;;
  fail) rc=1 ;;
  *)
    OPENCLAW_SERVICE_REPAIR_POLICY=external \
      /usr/local/bin/node /app/openclaw.mjs doctor --fix --non-interactive
    rc=$?
    ;;
esac
log "doctor exited $rc after $(( $(date +%s) - start ))s"

if [ "$rc" -eq 0 ]; then
  echo "$current" > "$stamp.tmp" && mv -f "$stamp.tmp" "$stamp"
  rm -f "$force"
  # Arm failed-start detection for the start that follows this repair. An
  # upgrade or forced repair starts a fresh attempt budget; a failed-start
  # repair keeps the count it already recorded.
  if [ "$mode" = closed ] || [ ! -e "$pending" ]; then
    echo 0 > "$pending"
  fi
  log "state repaired for $current"
  exit 0
fi

if [ "$mode" = closed ]; then
  log "doctor failed; refusing to start the gateway on unrepaired state ($reason)."
  log "the container stays up: inspect the log above, run 'openclaw doctor --fix' by hand, then 'openclaw gateway start'"
  exit 1
fi

log "doctor failed; starting anyway because this was a failed-start repair"
exit 0
